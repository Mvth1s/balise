# Copy to .env.local for local development. Never commit real values.

# Upstash Redis (injected automatically by the Vercel Marketplace integration).
# When absent, the API falls back to an in-memory store (development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret salt used to hash client IPs for rate limiting:
# HMAC-SHA-256(RATE_LIMIT_SALT, ip). Required on Vercel (the API answers 500
# without it); when empty locally, a random salt is drawn at each start.
RATE_LIMIT_SALT=

# Canonical public URL of the site (canonical links, sitemap, shared links).
# Inlined at build time.
VITE_SITE_URL=

# End-to-end tests only: "1" replaces the analysis engine with a fake one.
# Ignored when NODE_ENV=production or on Vercel. Never set it on Vercel.
# BALISE_E2E_FAKE_ANALYZER=1

# Google Analytics 4 measurement ID (G-XXXXXXX). When empty, no GA4 code is
# loaded and the consent banner is not shown.
VITE_GA_MEASUREMENT_ID=
