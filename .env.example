# Copy to .env.local for local development. Never commit real values.

# Upstash Redis (injected automatically by the Vercel Marketplace integration).
# When absent, the API falls back to an in-memory store (development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret salt used to hash client IPs for rate limiting (HMAC-SHA256).
RATE_LIMIT_SALT=

# Google Analytics 4 measurement ID (G-XXXXXXX). When empty, no GA4 code is
# loaded and the consent banner is not shown.
VITE_GA_MEASUREMENT_ID=
