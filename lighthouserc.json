{
  "ci": {
    "collect": {
      "startServerCommand": "E2E_SERVER_API=off node --experimental-strip-types scripts/e2e-server.ts",
      "startServerReadyPattern": "Balise e2e server ready",
      "startServerReadyTimeout": 30000,
      "url": ["http://127.0.0.1:4173/", "http://127.0.0.1:4173/exemple"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
